# ---------- Required ----------
JWT_SECRET=change-me-to-a-long-random-string-32+chars
PORT=3000
DB_PATH=chitloop.db

# ---------- Gmail for verification codes (sign-up AND login) ----------
# 1) Turn on 2-Step Verification for your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-letter password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=Chitloop <yourname@gmail.com>

# Ask for an emailed/texted code at every login (default on). Set to 0 to turn off.
LOGIN_CODE=1

# ---------- AI companions (live voice + smart chat) ----------
# Get a key at https://console.anthropic.com  (companions fall back to simple scripted replies without it)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# 1 = demo companions answer even before login. Set 0 to require login.
ALLOW_DEMO_AI=1

# ---------- SMS codes (optional, Twilio) ----------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+15551234567

# ---------- Calls: optional TURN relay (needed on some mobile/office networks) ----------
# Free/paid TURN from metered.ca, Twilio, Cloudflare, or your own coturn
TURN_URL=
TURN_USER=
TURN_PASS=

# Local testing ONLY: print codes in the server console when no provider is set. NEVER use in production.
DEV_LOG_CODES=
